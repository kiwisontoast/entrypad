{
  "name": "@entrypad/core",
  "version": "0.1.0",
  "description": "The Entrypad book model: chart of accounts, journal entries and the views derived from them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwisontoast/entrypad.git",
    "directory": "packages/core"
  },
  "homepage": "https://entrypad.devshroff.com",
  "bugs": "https://github.com/kiwisontoast/entrypad/issues",
  "keywords": [
    "accounting",
    "double-entry",
    "journal-entries",
    "t-accounts",
    "financial-statements",
    "parser",
    "ledger"
  ]
}
